# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=prediction_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=prediction_market

# ── Backend ───────────────────────────────────────────────
APP_ENV=production
DEBUG=False
SECRET_KEY=change_me_64_char_random_string_here

DATABASE_URL=postgresql+asyncpg://prediction_user:change_me_strong_password@db:5432/prediction_market
REDIS_URL=redis://redis:6379/0

ALLOWED_ORIGINS=["https://yourdomain.com"]

# ── TON wallet deposits ───────────────────────────────────
DEPOSIT_TON_ADDRESS=UQ...your_ton_wallet_address_here

# ── Telegram (optional) ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MINI_APP_URL=https://yourdomain.com
WEBHOOK_URL=https://yourdomain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=change_me_webhook_secret

# ── Admin seed account ────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=change_me_admin_password
