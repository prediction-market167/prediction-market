# Application
APP_NAME=PredictionMarket
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prediction_market
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_BOT_USERNAME=your_bot_username
MINI_APP_URL=https://your-mini-app-domain.com
WEBHOOK_URL=https://your-backend-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Initial Admin
FIRST_SUPERUSER_EMAIL=admin@predictionmarket.mn
FIRST_SUPERUSER_PASSWORD=changeme123
