    "@radix-ui/react-toast": "^1.2.3",
    "@reduxjs/toolkit": "^2.4.0",
    "@tanstack/react-query": "^5.62.7",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@tonconnect/ui-react": "^2.4.4",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^26.0.10",
    "lucide-react": "^0.468.0",
